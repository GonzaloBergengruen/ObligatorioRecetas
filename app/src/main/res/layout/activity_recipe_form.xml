<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAF7EF"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/formTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Nueva receta"
            android:textColor="#263730"
            android:textSize="28sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/formName"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="18dp"
            android:background="#FFFFFF"
            android:hint="Nombre de la receta "
            android:padding="12dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="CATEGORÍA"
            android:textColor="#70786F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/formCategory"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="ÁREA"
            android:textColor="#70786F"
            android:textSize="11sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/formArea"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:background="#FFFFFF" />

        <EditText
            android:id="@+id/formIngredients"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:layout_marginTop="10dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Ingredientes, uno por línea"
            android:padding="12dp" />

        <EditText
            android:id="@+id/formInstructions"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Instrucciones de preparación"
            android:padding="12dp" />

        <EditText
            android:id="@+id/formNotes"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="8dp"
            android:background="#FFFFFF"
            android:gravity="top"
            android:hint="Mis notas personales"
            android:padding="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/formSave"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:backgroundTint="#2E6E52"
                android:text="Guardar"
                android:textAllCaps="false" />

            <Button
                android:id="@+id/formCancel"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:backgroundTint="#E5EADF"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:textColor="#263730" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>